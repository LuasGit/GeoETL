# GeoETL - copiar este archivo a .env y cambiar ambas contraseñas
POSTGRES_DB=geoetl
POSTGRES_USER=geoetl_admin
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_PORT=5433
# Cuenta distinta, solo lectura para FastAPI
API_DB_PASSWORD=cambia_esta_clave_lectura
# FIRMS es opcional: sin clave se usa Open-Meteo
FIRMS_MAP_KEY=
# Se usan horarios UTC; el planificador es opcional y se arranca expresamente
SCHEDULER_INTERVAL_MINUTES=360
SCHEDULER_RUN_ON_START=true
# Solo el origen local de Vite; restringir en producción
CORS_ORIGINS=http://localhost:5173

# Token privado de operador (mínimo 24 caracteres aleatorios). Sin token, panel deshabilitado.
OPERATOR_TOKEN=
